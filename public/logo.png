<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <radialGradient id="bgGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#3d1b58"/>
      <stop offset="70%" stop-color="#241a2e"/>
      <stop offset="100%" stop-color="#181020"/>
    </radialGradient>
    <linearGradient id="goldRing" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffe28a"/>
      <stop offset="40%" stop-color="#d4af37"/>
      <stop offset="70%" stop-color="#b8862a"/>
      <stop offset="100%" stop-color="#f3e5ab"/>
    </linearGradient>
    <linearGradient id="roseCake" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff7597"/>
      <stop offset="100%" stop-color="#d94a76"/>
    </linearGradient>
    <linearGradient id="candleFlame" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#ff9900"/>
      <stop offset="60%" stop-color="#ffea00"/>
      <stop offset="100%" stop-color="#ffffff"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Outer Dark Circle Badge -->
  <circle cx="250" cy="250" r="236" fill="url(#bgGlow)" stroke="url(#goldRing)" stroke-width="8" />
  <circle cx="250" cy="250" r="222" fill="none" stroke="rgba(212, 175, 55, 0.4)" stroke-width="2" stroke-dasharray="4 6" />

  <!-- Sparkling Stars and Confetti in background -->
  <path d="M120 140 L124 152 L136 156 L124 160 L120 172 L116 160 L104 156 L116 152 Z" fill="#ffe28a" opacity="0.9" />
  <path d="M370 130 L373 140 L383 143 L373 146 L370 156 L367 146 L357 143 L367 140 Z" fill="#ffe28a" opacity="0.9" />
  <circle cx="150" cy="200" r="4" fill="#d94a76" opacity="0.8" />
  <circle cx="350" cy="210" r="5" fill="#d94a76" opacity="0.8" />
  <circle cx="200" cy="120" r="3.5" fill="#ffe28a" />
  <circle cx="300" cy="115" r="3.5" fill="#ffe28a" />

  <!-- Balloons Left & Right -->
  <g opacity="0.9">
    <ellipse cx="140" cy="160" rx="22" ry="28" fill="url(#roseCake)" />
    <path d="M140 188 L140 230 Q145 250 155 260" stroke="#b8862a" stroke-width="1.5" fill="none" opacity="0.6" />
    <ellipse cx="360" cy="170" rx="20" ry="26" fill="url(#goldRing)" />
    <path d="M360 196 L360 235 Q355 250 345 260" stroke="#b8862a" stroke-width="1.5" fill="none" opacity="0.6" />
  </g>

  <!-- Birthday Cake Center -->
  <g transform="translate(0, 10)">
    <!-- Plate / Stand -->
    <ellipse cx="250" cy="305" rx="90" ry="12" fill="url(#goldRing)" opacity="0.8" />
    <path d="M220 305 L225 320 L275 320 L280 305 Z" fill="url(#goldRing)" opacity="0.7" />

    <!-- Cake Bottom Tier -->
    <rect x="175" y="240" width="150" height="60" rx="10" fill="url(#roseCake)" />
    <!-- Cake Icing Droplets -->
    <path d="M175 250 Q190 265 200 250 Q215 265 225 250 Q240 265 250 250 Q265 265 275 250 Q290 265 300 250 Q315 265 325 250 L325 240 L175 240 Z" fill="#ffffff" opacity="0.9" />

    <!-- Cake Top Tier -->
    <rect x="200" y="195" width="100" height="45" rx="8" fill="#4a2170" stroke="url(#goldRing)" stroke-width="2" />
    <path d="M200 205 Q212 215 225 205 Q237 215 250 205 Q262 215 275 205 Q287 215 300 205 L300 195 L200 195 Z" fill="#ffffff" opacity="0.95" />

    <!-- Candles -->
    <!-- Candle 1 -->
    <rect x="220" y="165" width="6" height="30" rx="2" fill="url(#goldRing)" />
    <ellipse cx="223" cy="155" rx="4" ry="7" fill="url(#candleFlame)" filter="url(#glow)" />
    <!-- Candle 2 (Center) -->
    <rect x="247" y="158" width="6" height="37" rx="2" fill="#d94a76" />
    <ellipse cx="250" cy="148" rx="5" ry="8" fill="url(#candleFlame)" filter="url(#glow)" />
    <!-- Candle 3 -->
    <rect x="274" y="165" width="6" height="30" rx="2" fill="url(#goldRing)" />
    <ellipse cx="277" cy="155" rx="4" ry="7" fill="url(#candleFlame)" filter="url(#glow)" />
  </g>

  <!-- Arched Top Text / Ribbon -->
  <path id="textArcTop" d="M 90 240 A 170 170 0 0 1 410 240" fill="none" />
  <text font-family="'Fraunces', serif" font-weight="700" font-size="28" fill="url(#goldRing)" letter-spacing="3" text-anchor="middle">
    <textPath href="#textArcTop" startOffset="50%">C'EST SON</textPath>
  </text>

  <!-- Ribbon Banner Bottom for "ANNIVERSAIRE" -->
  <g transform="translate(0, 315)">
    <!-- Ribbon Shadow -->
    <path d="M 80 45 L 120 70 L 120 30 Z" fill="#200a35" />
    <path d="M 420 45 L 380 70 L 380 30 Z" fill="#200a35" />
    
    <!-- Main Ribbon Body -->
    <rect x="100" y="15" width="300" height="48" rx="8" fill="url(#roseCake)" stroke="url(#goldRing)" stroke-width="2.5" />
    
    <!-- Ribbon Ends Fold -->
    <path d="M 75 25 L 105 15 L 105 60 L 75 50 L 90 37.5 Z" fill="#b8862a" stroke="url(#goldRing)" stroke-width="1.5" />
    <path d="M 425 25 L 395 15 L 395 60 L 425 50 L 410 37.5 Z" fill="#b8862a" stroke="url(#goldRing)" stroke-width="1.5" />

    <!-- Text inside Ribbon -->
    <text x="250" y="47" font-family="'Fraunces', serif" font-weight="700" font-size="23" fill="#ffffff" letter-spacing="4" text-anchor="middle" filter="url(#glow)">
      ANNIVERSAIRE
    </text>
  </g>

  <!-- Bottom Slogan / Stars -->
  <text x="250" y="435" font-family="'Plus Jakarta Sans', sans-serif" font-weight="600" font-size="13" fill="#ffe28a" letter-spacing="3" text-anchor="middle">
    ★ MOMENTS D'EXCEPTION ★
  </text>
</svg>
